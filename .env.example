# Backend environment variables. Copy this file to .env (project root) and
# fill in your values — main.py's load_dotenv() reads .env from the current
# working directory, which is the project root when running
# `uvicorn backend.main:app` from here (see README.md).
#
# Only variables the backend code actually reads are listed below —
# see database.py / main.py if you're checking this against the source.

# Where SQLite DB files + config live. Defaults to backend/ if unset.
YANTAGE_DATA_DIR=./backend

# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
